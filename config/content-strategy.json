{
  "channel_positioning": "Gaming storytelling: characters, in-game stories, history, rivalries, mysteries and clearly labeled fiction.",
  "story_first": true,
  "categories": ["CHARACTER", "GAME", "EVENT_HISTORY", "MYSTERY"],
  "hard_filter": {
    "reject_admin_only": true,
    "reject_terms": ["xe bus", "xe đưa đón", "đăng ký nhận vé", "lịch nhận vé", "hướng dẫn nhận quà", "bảo trì", "khuyến mãi", "nhập code", "lịch sự kiện"],
    "allow_event_only_when_story_angle": true,
    "fact_claim_requires_source": true,
    "unverified_claim_policy": "BLOCK_AS_FACT; may be labeled FAN_THEORY or FICTION only when appropriate"
  },
  "storytelling_score": {
    "minimum": 75,
    "weights": {
      "story_appeal": 25,
      "conflict_mystery_climax": 20,
      "curiosity_hook": 20,
      "emotion_debate": 15,
      "gaming_community_fit": 10,
      "narrative_originality_and_clarity": 10
    }
  },
  "media_feasibility": {
    "production_minimum": 70,
    "scene_values": {
      "authorized_asset": 100,
      "fact_grounded_original_graphic": 85,
      "review_required_asset": 25,
      "missing": 0
    },
    "note": "Separate production-readiness estimate; never use as trend, popularity, or legal-rights evidence. Original graphics must be fact-grounded and labeled when depicting a real event."
  },
  "ranking": {
    "storytelling_score_weight": 0.5,
    "viral_potential_score_weight": 0.2,
    "media_feasibility_score_weight": 0.3,
    "hot_score_role": "verified_tiebreaker_only",
    "viral_score_is_prediction": false
  },
  "research": {"ideas_target": 10, "shortlist_size": 3, "finalist_report_size": 5},
  "story_structure": ["HOOK", "SETUP", "CONFLICT", "CLIMAX", "PAYOFF", "ENDING"],
  "voice": {
    "engine": "VieNeu-TTS",
    "version": "3.7.1",
    "preset": "Minh Quân",
    "required": true,
    "block_if_unavailable": true,
    "allow_automatic_production_fallback": false,
    "meme_pause_seconds": {"min": 0.5, "max": 0.8}
  },
  "production": {
    "video_style": "yuzhen-event-storytelling",
    "resolution": "1080x1920",
    "fps": 30,
    "duration_seconds": {"min": 35, "max": 60},
    "never_present_motion_graphics_as_gameplay": true,
    "verify_media_reuse_rights": true
  }
}
