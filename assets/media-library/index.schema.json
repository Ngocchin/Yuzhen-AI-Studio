{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yuzhen authorized media library index",
  "type": "object",
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "path", "game", "source_url", "owner", "license", "checked_at", "scope", "permitted_platforms", "commercial_use", "editing_allowed", "underlying_rights_cleared", "status", "sha256"],
        "properties": {
          "asset_id": {"type": "string"},
          "game": {"type": "string"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "scene_tags": {"type": "array", "items": {"type": "string"}},
          "source_url": {"type": "string", "format": "uri"},
          "owner": {"type": "string"},
          "license": {"type": "string"},
          "license_url": {"type": ["string", "null"]},
          "checked_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "scope": {"type": "string"},
          "permitted_platforms": {"type": "array", "items": {"type": "string"}},
          "commercial_use": {"type": "boolean"},
          "editing_allowed": {"type": "boolean"},
          "underlying_rights_cleared": {"type": "boolean"},
          "attribution": {"type": "string"},
          "status": {"const": "AUTHORIZED"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
